<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted to the loopback interface only: the emulator smoke
     points the agent's SDK client at an on-device stub model server. All real
     API traffic remains HTTPS to api.anthropic.com. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

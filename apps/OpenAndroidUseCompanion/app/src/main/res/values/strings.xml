    <string name="onboarding_accessibility_title">Enable the accessibility service</string>
    <string name="onboarding_accessibility_body">The agent works through Android\'s accessibility service — that\'s how it sees the screen and performs taps and gestures. Turn it on for \"Open Android Use Companion\".</string>
